{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2023"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/*/src/**/*.tsx",
    "../../packages/*/src/**/*.ts",
    "../../packages/brand/tokens/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-film/types/**/*.ts",
    ".next-film/dev/types/**/*.ts",
    ".next-site/types/**/*.ts",
    ".next-site/dev/types/**/*.ts",
    ".next-dash/types/**/*.ts",
    ".next-dash/dev/types/**/*.ts",
    ".next-vitrine/types/**/*.ts",
    ".next-vitrine/dev/types/**/*.ts",
    ".next-commerce/types/**/*.ts",
    ".next-commerce/dev/types/**/*.ts",
    ".next-studio/types/**/*.ts",
    ".next-studio/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    ".next-*"
  ]
}
